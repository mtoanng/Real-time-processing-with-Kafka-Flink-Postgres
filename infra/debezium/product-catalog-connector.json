{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.dbname": "catalog",
  "database.user": "catalog",
  "database.password": "",
  "topic.prefix": "product-catalog",
  "schema.include.list": "public",
  "table.include.list": "public.product_catalog",
  "plugin.name": "pgoutput",
  "slot.name": "product_catalog_slot",
  "publication.name": "product_catalog_publication",
  "publication.autocreate.mode": "filtered",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "tombstones.on.delete": "false",
  "transforms": "unwrap,route",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "product-catalog.public.product_catalog",
  "transforms.route.replacement": "product-catalog-cdc"
}
