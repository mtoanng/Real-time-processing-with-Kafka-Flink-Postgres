# Active runtime: Kafka, Schema Registry, Flink SQL, and ClickHouse only.
RUNTIME_PROFILE=core
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=user-behavior-events
KAFKA_RAW_OUTPUT_TOPIC=taobao-raw-events
KAFKA_METRICS_OUTPUT_TOPIC=taobao-item-metrics-1m
KAFKA_QUALITY_OUTPUT_TOPIC=taobao-quality-events
KAFKA_CONSUMER_GROUP=taobao-sql-pipeline
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/ccompat/v7
SCHEMA_REGISTRY_CLIENT_URL=http://localhost:8081/apis/ccompat/v7
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=
CLICKHOUSE_ENDPOINT=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=local-clickhouse
CLICKHOUSE_DATABASE=taobao_behavior
# The settings below belong to deprecated/non-active extensions.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CART_TTL_SECONDS=604800
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=local-catalog
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_CONNECT_REPLICATION_FACTOR=1
EVENT_API_URL=http://localhost:8000/v1/events

# Bounded replay and Flink state/event-time controls.
REPLAY_RUN_ID=fixture-run
REPLAY_SPEED_FACTOR=0
REPLAY_BATCH_SIZE=100
FLINK_CHECKPOINTING_ENABLED=true
FLINK_CHECKPOINT_INTERVAL_MS=60000
FLINK_CHECKPOINT_DIR=file:///var/lib/flink/checkpoints
FLINK_RESTART_ATTEMPTS=3
FLINK_RESTART_DELAY_MS=10000
FLINK_DEDUP_RETENTION_HOURS=168
FLINK_MAX_OUT_OF_ORDERNESS_MS=5000
