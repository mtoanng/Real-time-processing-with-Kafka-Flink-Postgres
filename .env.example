# Core: Kafka + Schema Registry + one SQL/PyFlink job + ClickHouse + Redis
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=user-behavior-events
KAFKA_RAW_OUTPUT_TOPIC=taobao-raw-events
KAFKA_METRICS_OUTPUT_TOPIC=taobao-item-metrics-1m
KAFKA_QUALITY_OUTPUT_TOPIC=taobao-quality-events
KAFKA_CART_MUTATION_TOPIC=taobao-active-cart-mutations
KAFKA_CONSUMER_GROUP=taobao-python-sql-pipeline
KAFKA_SOURCE_BOUNDED=false
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Local Compose uses these names. The EC2 deploy script overrides them with
# local image tags containing the exact Git commit SHA.
FLINK_RUNTIME_IMAGE=taobao-flink-runtime:local
APP_RUNTIME_IMAGE=taobao-app-runtime:local
RUNTIME_IMAGES_PREBUILT=false

# Optional only for non-Compose submission. The custom runtime image already
# puts this connector bundle on the Flink platform classpath.
FLINK_CONNECTOR_JAR=/opt/flink/lib/taobao-flink-connectors.jar
FLINK_CHECKPOINT_DIR=file:///var/lib/flink/checkpoints
FLINK_CHECKPOINT_INTERVAL_MS=60000
FLINK_TASKMANAGER_PROCESS_MEMORY=4096m
FLINK_RESTART_ATTEMPTS=3
FLINK_RESTART_DELAY_MS=10000
FLINK_DEDUP_RETENTION_HOURS=168
FLINK_CART_STATE_TTL_HOURS=168
FLINK_MAX_OUT_OF_ORDERNESS_MS=5000

CLICKHOUSE_ENDPOINT=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=local-clickhouse
CLICKHOUSE_DATABASE=taobao_behavior
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_CART_TTL_SECONDS=604800

# Approved catalog CDC extension
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=local-catalog
KAFKA_CONNECT_URL=http://localhost:8083

# Approved HTTP boundary
EVENT_API_URL=http://localhost:8000/v1/events
REPLAY_RUN_ID=fixture-run
