-- Kafka/Avro input. Avro decoding remains a JVM connector capability; no Java
-- business pipeline is authored by the Data Engineer.
CREATE TABLE behavior_events (
    event_id STRING,
    user_id BIGINT,
    item_id BIGINT,
    category_id BIGINT,
    behavior_type STRING,
    event_time_ms BIGINT,
    source_sequence BIGINT,
    replay_run_id STRING
) WITH (
    'connector' = 'kafka',
    'topic' = '{{BEHAVIOR_TOPIC}}',
    'properties.bootstrap.servers' = '{{KAFKA_BOOTSTRAP_SERVERS}}',
    'properties.group.id' = '{{CONSUMER_GROUP}}-behavior',
    'scan.startup.mode' = 'earliest-offset',
    {{BEHAVIOR_BOUNDED_OPTION}}
    'value.format' = 'avro-confluent',
    'value.avro-confluent.url' = '{{SCHEMA_REGISTRY_URL}}'{{SOURCE_SECURITY_OPTIONS}}
);

-- Raw Debezium envelope is decoded by the built-in debezium-json format.
-- PostgreSQL forbids physical deletes; is_active=false is the domain delete.
CREATE TABLE product_catalog_changes (
    product_id BIGINT,
    category_id BIGINT,
    product_name STRING,
    price DECIMAL(12, 2),
    is_active BOOLEAN,
    updated_at TIMESTAMP_LTZ(3),
    catalog_version BIGINT,
    PRIMARY KEY (product_id) NOT ENFORCED
) WITH (
    'connector' = 'kafka',
    'topic' = '{{CATALOG_TOPIC}}',
    'properties.bootstrap.servers' = '{{KAFKA_BOOTSTRAP_SERVERS}}',
    'properties.group.id' = '{{CONSUMER_GROUP}}-catalog',
    'scan.startup.mode' = 'earliest-offset',
    {{CATALOG_BOUNDED_OPTION}}
    'format' = 'debezium-json',
    'debezium-json.schema-include' = 'false',
    'debezium-json.ignore-parse-errors' = 'false'{{KAFKA_SECURITY_OPTIONS}}
);

CREATE TABLE raw_events_out (
    event_id STRING,
    user_id BIGINT,
    item_id BIGINT,
    category_id BIGINT,
    behavior_type STRING,
    event_time_ms BIGINT,
    source_sequence BIGINT,
    replay_run_id STRING,
    record_version BIGINT
) WITH (
    'connector' = 'kafka',
    'topic' = '{{RAW_TOPIC}}',
    'properties.bootstrap.servers' = '{{KAFKA_BOOTSTRAP_SERVERS}}',
    'sink.delivery-guarantee' = 'at-least-once',
    'format' = 'json'{{KAFKA_SECURITY_OPTIONS}}
);

CREATE TABLE metrics_out (
