    'connector' = 'upsert-kafka',
    'topic' = '{{CART_MUTATION_TOPIC}}',
    'properties.bootstrap.servers' = '{{KAFKA_BOOTSTRAP_SERVERS}}',
    'sink.delivery-guarantee' = 'at-least-once',
    'key.format' = 'json',
    'value.format' = 'json'{{KAFKA_SECURITY_OPTIONS}}
);
