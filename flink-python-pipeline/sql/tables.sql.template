CREATE TABLE product_catalog_out (
    product_id BIGINT,
    category_id BIGINT,
    product_name STRING,
    price DECIMAL(12, 2),
    is_active BOOLEAN,
    updated_at_ms BIGINT,
    catalog_version BIGINT,
    PRIMARY KEY (product_id) NOT ENFORCED
) WITH (
    'connector' = 'upsert-kafka',
    'topic' = '{{CATALOG_OUTPUT_TOPIC}}',
    'properties.bootstrap.servers' = '{{KAFKA_BOOTSTRAP_SERVERS}}',
    'sink.delivery-guarantee' = 'at-least-once',
    'key.format' = 'json',
    'value.format' = 'json'{{KAFKA_SECURITY_OPTIONS}}
);

CREATE TABLE cart_mutations_out (
    operation STRING,
    user_id BIGINT,
    item_id BIGINT,
    category_id BIGINT,
    added_at_ms BIGINT,
    last_updated_at_ms BIGINT,
    PRIMARY KEY (user_id, item_id) NOT ENFORCED
